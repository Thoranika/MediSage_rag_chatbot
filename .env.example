# MediSage Environment Configuration
# Copy this file to `.env` and set your own API key. NEVER commit `.env` to Git.

# --- Cloud LLM Provider Configuration ---
# Supported provider: GEMINI
LLM_PROVIDER=GEMINI
# Default Gemini Flash-class model (verify supported model IDs in Google Gemini API docs)
LLM_MODEL_ID=gemini-2.5-flash
# Use v1beta so system_instruction (developer instructions) and Gemini 2.5 options work properly
GEMINI_API_VERSION=v1beta
# Set your Google Gemini API key here
GEMINI_API_KEY=your_gemini_api_key_here

# --- Local CPU Embeddings & Vector Store ---
EMBEDDING_MODEL_NAME=all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
CHROMA_PERSIST_DIR=data/chroma_db
CHROMA_COLLECTION_NAME=medisage_chunks

# --- Storage & Upload Security Limits ---
SQLITE_DB_PATH=data/medisage.db
UPLOAD_DIR=data/uploads
MAX_UPLOAD_SIZE_MB=20

# --- RAG & Retrieval Defaults (Tuned via Milestone 3 Evaluation) ---
CHUNK_SIZE_TOKENS=600
CHUNK_OVERLAP_TOKENS=100
RETRIEVAL_TOP_K=4
SIMILARITY_THRESHOLD=0.32
MAX_HISTORY_TURNS=4
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TIMEOUT_SECONDS=30
RESPONSE_STYLE=Concise

# --- Logging ---
LOG_LEVEL=INFO
LOG_DIR=logs
